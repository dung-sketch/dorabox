PORT=4000
NODE_ENV=development

# Supabase Credentials (Lấy từ Supabase Studio > Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare R2 Credentials (Lấy từ Cloudflare Dashboard > R2 > Manage R2 API Tokens)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=dorabox-media
R2_PUBLIC_URL=https://pub-your-domain.r2.dev

# Admin Security Key (Bảo mật truy cập Admin Portal - Sử dụng chuỗi ngẫu nhiên tối thiểu 32 ký tự)
ADMIN_SECRET_KEY=replace_with_a_secure_random_64_character_hex_key

# Firebase Cloud Messaging (Dùng Base64 string hoặc đường dẫn file bên ngoài, KHÔNG commit key vào git)
# Tạo base64: node -e "console.log(Buffer.from(fs.readFileSync('service-account.json')).toString('base64'))"
FIREBASE_SERVICE_ACCOUNT_KEY=your_base64_encoded_service_account_json_here
# Hoặc chỉ định đường dẫn:
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json

# Agora RTC Voice & Video Calling
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
